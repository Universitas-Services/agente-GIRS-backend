# === Proyecto GCP: consultoria-girs ===
GOOGLE_CLOUD_PROJECT=consultoria-girs
GOOGLE_CLOUD_LOCATION=us-central1

# Número de proyecto (referencia / IAM; no lo lee el agente en runtime)
# PROJECT_NUMBER=357817461800

# App / Engine de Vertex AI Search (ruta /engines/...)
ENGINE_ID=consultoria-girs-app_1788892468567

# Data Store asociado (referencia; el RAG usa ENGINE_ID)
# DATA_STORE_ID=consultoria-girs-dw_1788891386873

# Location del Discovery Engine (en consultoria-girs: "us", no "global")
DISCOVERY_ENGINE_LOCATION=us

# Bucket de documentos / artefactos (sin prefijo gs://)
LOGS_BUCKET_NAME=consultoria-girs-bucket

# Opcional: Agent Engine (Reasoning Engine) tras el primer deploy con agents-cli
# GOOGLE_CLOUD_AGENT_ENGINE_ID=4399890941859594240

# Opcional: CORS (lista separada por comas)
# ALLOW_ORIGINS=https://tu-frontend.example.com

# Desarrollo local
DEBUG=True
LOG_LEVEL=INFO
